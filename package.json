  "repository": {
    "type": "git",
    "url": "git+https://github.com/mats16/pi-session-zstd.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "sessions",
    "zstd",
